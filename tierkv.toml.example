# tierkv.toml — cluster configuration
#
# Copy this file to tierkv.toml and fill in your node addresses.
# tierkv.toml is gitignored (contains personal IPs).
#
# Search order: TIERKV_CONFIG env var → ./tierkv.toml → ~/.config/tierkv/tierkv.toml

[cluster]
# Role this node plays: "inference", "kv_cold", "ssm_cold"
role = "inference"

[cluster.kv_cold]
# Cold storage node for KVCache layers (full-attention, typically ~10 layers)
host = "192.168.50.11"
port = 50051

[cluster.ssm_cold]
# Cold storage node for ArraysCache layers (linear-attention/SSM, typically ~30 layers)
host = "192.168.10.174"
port = 50051

[cluster.recompute]
# Inference node for KV recomputation on cache miss (usually localhost on inference node)
host = "127.0.0.1"
port = 50052

[inference]
# Path to your EXO installation (used by `tierkv install`)
exo_path = "/home/user/exo/src/exo"

# Log file for the EXO hook (on the inference node)
log_file = "/tmp/tierkv.log"

# Evict hot KV cache when RAM usage exceeds this fraction (0.0–1.0)
memory_threshold = 0.60

# KV head dimension for TurboQuant — must match your model's attention head_dim.
# Using the wrong value causes silently incorrect compression.
#
# Common values:
#   Qwen3.6-35B-A3B (MoE, full-attention layers): 256
#   Llama-3 8B / 70B (GQA):                       128
#   Qwen2.5 7B / 14B / 32B:                        128
#   Mistral 7B:                                    128
#   Phi-3 medium:                                   96
#
# To find the right value for any model:
#   head_dim = hidden_size / num_attention_heads
#   (or look for "head_dim" directly in the model's config.json)
kv_dim = 256

[vault]
# Port for the ColdVault gRPC server on this node
port = 50051

# LRU eviction: evict oldest blocks when vault RAM exceeds this limit.
# Set to leave ~4 GB headroom for the OS and other processes.
# 0 = unlimited (default — vault grows until OOM).
#
# Mac Air (16 GB):  max_bytes = 12000000000
# Mac Pro (32 GB):  max_bytes = 28000000000
# max_bytes = 12000000000

# Optional: persist KV cache to disk across reboots (leave unset for in-memory only)
# persist_path = "/var/lib/tierkv/cold_vault.db"

[tierkv]
# Optional: path to SQLite db that persists the block_hash → vault_key registry
# across vLLM restarts. Without this, vault blocks become unreachable on restart.
# Uncomment and set to a stable path (directory must exist):
# registry_db_path = "/home/user/.local/share/tierkv/registry.db"
